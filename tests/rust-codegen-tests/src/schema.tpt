package codegen_test.v1;

message Address {
  1: street string;
  2: city string?;
}

message Outer_Child_Leaf {
  1: value bool;
}

message Outer_Child {
  1: note string;
  2: depth int64;
  3: leaf Outer_Child_Leaf?;
}

message Outer {
  1: id int64;
  2: name string;
  3: email string?;
  4: age int64?;
  5: username string @max_len(128);
  6: repeated tags string;
  7: repeated scores int64;
  8: map<string, string> attrs;
  9: map<int64, string> counts;
  oneof contact {
    10: email_addr string;
    11: phone string;
    12: addr Address;
  }
  enum Status {
    ACTIVE = 0;
    INACTIVE = 1;
    SUSPENDED = 2;
  }
  13: Status status;
  open enum Feature {
    NONE = 0;
    BETA = 1;
  }
  14: Feature feature;
  15: Address home;
  16: bytes blob;
  17: float64 ratio;
  18: repeated flags uint32;
  19: Outer_Child inner;
  20: sint64 zigzag;
}
