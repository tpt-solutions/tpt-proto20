package codegen_test.v1;

message Address {
  1: street string;
  2: city string?;
}

message Outer_Child_Leaf {
  1: value bool;
}

message Outer_Child {
  1: note string;
  2: depth int64;
  3: leaf Outer_Child_Leaf?;
}

message Outer {
  1: id int64;
  2: name string;
  3: email string?;
  4: age int64? @range(0, 150);
  5: username string @max_len(8);
  6: tags repeated string;
  7: scores repeated int64;
  8: attrs map<string, string>;
  9: counts map<int64, string>;
  oneof contact {
    10: email_addr string;
    11: phone string;
    12: addr Address;
  }
  enum Status {
    ACTIVE = 0;
    INACTIVE = 1;
    SUSPENDED = 2;
  }
  13: status Status;
  open enum Feature {
    NONE = 0;
    BETA = 1;
  }
  14: feature Feature;
  15: home Address;
  16: blob bytes;
  17: ratio float64;
  18: flags repeated uint32;
  19: inner Outer_Child;
  20: zigzag sint64;
  21: homes map<string, Address>;
  22: status_by_name map<string, Status>;
  23: address_book repeated Address;
  24: statuses repeated Status;
}

message PingRequest {
  1: text string;
  2: count int32;
}

message PingReply {
  1: text string;
  2: n int32;
}

service Pinger {
  Ping(PingRequest) returns (PingReply);
  Repeat(PingRequest) returns (stream PingReply);
  Collect(stream PingRequest) returns (PingReply);
  Chat(stream PingRequest) returns (stream PingReply);
  Fail(PingRequest) returns (PingReply);
  GetHTTPStatus(PingRequest) returns (PingReply);
}

message Tree {
  1: value int64;
  2: left Tree;
  3: right Tree;
  4: children repeated Tree;
  5: by_name map<string, Tree>;
}

message Pair {
  1: l Expr;
  2: r Expr;
}

message Expr {
  oneof kind {
    1: lit int64;
    2: neg Expr;
    3: add Pair;
  }
}

message DiffInner {
  1: x string;
  2: y int32;
}

message Diff {
  1: a int32;
  2: b int64;
  3: c uint32;
  4: d uint64;
  5: e sint32;
  6: f sint64;
  7: g bool;
  8: h fixed32;
  9: i fixed64;
  10: j sfixed32;
  11: k sfixed64;
  12: l float32;
  13: m float64;
  14: s string;
  15: by bytes;
  16: rp repeated int32;
  17: rs repeated string;
  18: rz repeated sint64;
  19: rd repeated float64;
  20: m1 map<string, int64>;
  21: nested DiffInner;
  22: opt int32?;
  25: mm map<string, DiffInner>;
  26: rn repeated DiffInner;
  oneof pick {
    23: pa int32;
    24: pb string;
  }
}
