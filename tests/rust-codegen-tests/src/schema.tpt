package codegen_test.v1;

message Address {
  1: street string;
  2: city string?;
}

message Outer_Child_Leaf {
  1: value bool;
}

message Outer_Child {
  1: note string;
  2: depth int64;
  3: leaf Outer_Child_Leaf?;
}

message Outer {
  1: id int64;
  2: name string;
  3: email string?;
  4: age int64?;
  5: username string @max_len(128);
  6: tags repeated string;
  7: scores repeated int64;
  8: attrs map<string, string>;
  9: counts map<int64, string>;
  oneof contact {
    10: email_addr string;
    11: phone string;
    12: addr Address;
  }
  enum Status {
    ACTIVE = 0;
    INACTIVE = 1;
    SUSPENDED = 2;
  }
  13: status Status;
  open enum Feature {
    NONE = 0;
    BETA = 1;
  }
  14: feature Feature;
  15: home Address;
  16: blob bytes;
  17: ratio float64;
  18: flags repeated uint32;
  19: inner Outer_Child;
  20: zigzag sint64;
}
